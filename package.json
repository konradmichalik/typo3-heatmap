{
  "name": "typo3-heatmap-widget",
  "version": "1.0.0",
  "description": "TYPO3 extension providing GitHub-style heatmap widgets",
  "scripts": {
    "build": "tsc",
    "build:prod": "npm run clean && tsc --sourceMap false",
    "watch": "tsc --watch",
    "clean": "rm -rf Resources/Public/JavaScript/dist",
    "dev": "npm run clean && npm run watch",
    "test:js": "TZ=Europe/Berlin vitest run",
    "test:js:watch": "TZ=Europe/Berlin vitest",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "typo3",
    "heatmap",
    "github",
    "contribution",
    "dashboard",
    "typescript"
  ],
  "author": "Konrad Michalik",
  "license": "GPL-3.0-or-later"
}
